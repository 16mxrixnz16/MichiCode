# Backend MichiCode - desarrollo local (npm run dev). Copiar a backend/.env
PORT=5000
# Mongo publicado por docker compose en 127.0.0.1:27017 (mismas credenciales que el .env de la raíz)
MONGODB_URI=mongodb://root:rootpassword@localhost:27017/michicode?authSource=admin
# Host usado para construir las URLs cortas y los QR
PUBLIC_URL_HOST=http://localhost:5000
